<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ReversalCrop.App.ViewModels"
        x:Class="ReversalCrop.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title=""
        Width="980"
        Height="660"
        MinWidth="700"
        MinHeight="500"
        CanResize="True"
        CanMaximize="True"
        WindowStartupLocation="CenterScreen"
        Background="#242426">

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#F6F5F4"/>
            <Setter Property="FontFamily" Value="Inter"/>
        </Style>

        <Style Selector="Button">
            <Setter Property="Background" Value="#3B3B3F"/>
            <Setter Property="Foreground" Value="#F6F5F4"/>
            <Setter Property="BorderBrush" Value="#515156"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#484848"/>
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#3584E4"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3584E4"/>
        </Style>

        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="#4A91EA"/>
        </Style>
        <Style Selector="Button:pressed"><Setter Property="Background" Value="#303034"/></Style>
        <Style Selector="ToggleButton.export-size">
            <Setter Property="Background" Value="#3B3B3F"/>
            <Setter Property="Foreground" Value="#F6F5F4"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.export-size:pointerover"><Setter Property="Background" Value="#48484C"/></Style>
        <Style Selector="ToggleButton.export-size:checked"><Setter Property="Background" Value="#3584E4"/></Style>
        <Style Selector="ToggleButton.export-size:disabled"><Setter Property="Opacity" Value="0.55"/></Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="#303034"/>
            <Setter Property="Foreground" Value="#F6F5F4"/>
            <Setter Property="BorderBrush" Value="#505050"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>

        <Style Selector="Slider"><Setter Property="Foreground" Value="#78AEED"/></Style>
        <Style Selector="Slider /template/ Track"><Setter Property="Height" Value="6"/></Style>
    </Window.Styles>

    <Grid RowDefinitions="*,54" ColumnDefinitions="*,276">
        <Grid Grid.Row="0" Grid.Column="0" Background="#242426" ClipToBounds="True">
                    <Border IsVisible="{Binding HasImage}" Background="#2A2A2D">
                        <Border.Background>
                            <VisualBrush TileMode="Tile" DestinationRect="0,0,32,32" SourceRect="0,0,32,32" Stretch="None">
                                <VisualBrush.Visual>
                                    <Grid RowDefinitions="16,16" ColumnDefinitions="16,16" Width="32" Height="32">
                                        <Border Background="#303034"/>
                                        <Border Grid.Column="1" Background="#29292C"/>
                                        <Border Grid.Row="1" Background="#29292C"/>
                                        <Border Grid.Row="1" Grid.Column="1" Background="#303034"/>
                                    </Grid>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Border.Background>
                    </Border>

                    <Image Source="{Binding PreviewImage}"
                           IsVisible="{Binding HasImage}"
                           Stretch="Uniform"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"
                           Margin="18"
                           PointerPressed="Preview_PointerPressed"
                           PointerMoved="Preview_PointerMoved"
                           PointerReleased="Preview_PointerReleased"
                           PointerWheelChanged="Preview_PointerWheelChanged"/>

                    <Button IsVisible="{Binding HasNoImage}"
                            Width="76"
                            Height="76"
                            Padding="0"
                            CornerRadius="18"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="OpenImage_Click">

                        <TextBlock Text="＋"
                                   FontSize="34"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="0,-5,0,0"/>
                    </Button>
        </Grid>

        <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
              Background="#303034" RowDefinitions="*,Auto">

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="16,18">
                    <StackPanel Spacing="14">

                    <TextBlock Text="ENQUADRAMENTO"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="#A1A09D"/>

                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Zoom" FontSize="12"/>
                            <TextBlock Text="{Binding Zoom}"
                                       Grid.Column="1"
                                       FontSize="11"
                                       Foreground="#C0BFBC"/>
                        </Grid>

                        <Slider Minimum="25"
                                Maximum="300"
                                Value="{Binding Zoom, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Posição X" FontSize="12"/><TextBlock Grid.Column="1" Text="{Binding OffsetX, StringFormat={}{0:0}}%" FontSize="11" Foreground="#C0BFBC"/></Grid>
                        <Slider Minimum="-100"
                                Maximum="100"
                                Value="{Binding OffsetX, Mode=TwoWay}"/>

                        <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Posição Y" FontSize="12"/><TextBlock Grid.Column="1" Text="{Binding OffsetY, StringFormat={}{0:0}}%" FontSize="11" Foreground="#C0BFBC"/></Grid>

                        <Slider Minimum="-100"
                                Maximum="100"
                                Value="{Binding OffsetY, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="PERFIL"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#A1A09D"/>

                        <TextBlock Text="Margem  ·  4.5 / 64" FontSize="12" Foreground="#C0BFBC"/>
                        <TextBlock Text="Dimensão  ·  55 / 64" FontSize="12" Foreground="#C0BFBC"/>
                        <TextBlock Text="Raio  ·  15 / 64" FontSize="12" Foreground="#C0BFBC"/>
                    </StackPanel>

                    <StackPanel Spacing="7">
                        <TextBlock Text="EXPORTAÇÃO"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#A1A09D"/>

                        <StackPanel Spacing="6">
                            <ToggleButton Classes="export-size" Content="512 × 512"
                                          HorizontalAlignment="Stretch"
                                          IsChecked="{Binding Export512Selected, Mode=TwoWay}"/>
                            <ToggleButton Classes="export-size" Content="2508 × 2508"
                                          HorizontalAlignment="Stretch"
                                          IsChecked="{Binding Export2508Selected, Mode=TwoWay}"/>
                        </StackPanel>

                        <TextBlock Text="PNG"
                                   FontSize="11"
                                   Foreground="#A1A09D"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="1" Spacing="8" Margin="16,10,16,16">
                <Button Content="Abrir imagem" HorizontalAlignment="Stretch"
                        Click="OpenImage_Click"/>
                <Button Content="Exportar" Classes="primary" HorizontalAlignment="Stretch"
                        IsEnabled="{Binding HasSourceImage}" Click="Export_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Grid.Column="0" Background="#242426" Padding="18,8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" FontSize="12" Foreground="#C0BFBC"/>
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" VerticalAlignment="Center" FontSize="12" Foreground="#C0BFBC"/>
            </Grid>
        </Border>
    </Grid>
</Window>
